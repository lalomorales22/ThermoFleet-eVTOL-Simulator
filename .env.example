# FlyingCarRL Configuration
# Copy this file to .env and fill in your actual values

# ===========================
# Cesium Configuration
# ===========================
# Get your API key from https://cesium.com/ion/
CESIUM_ION_TOKEN=your_cesium_ion_token_here

# ===========================
# Database Configuration
# ===========================
# Database type: sqlite or mysql
DB_TYPE=sqlite

# SQLite Configuration (default)
SQLITE_DB_PATH=data/database/flyingcar_rl.db

# MySQL Configuration (optional, for production)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=flyingcar_user
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=flyingcar_rl

# ===========================
# NVIDIA Omniverse
# ===========================
# Path to Isaac Lab installation
ISAAC_LAB_PATH=/path/to/isaac-lab

# Omniverse nucleus server (if using shared storage)
OMNIVERSE_NUCLEUS_URL=omniverse://localhost

# ===========================
# Simulation Configuration
# ===========================
# Default number of agents
DEFAULT_NUM_AGENTS=100

# Simulation mode: visual or headless
DEFAULT_SIM_MODE=headless

# Altitude constraints (in feet)
MIN_ALTITUDE_FT=400
MAX_ALTITUDE_FT=500

# Physics timestep (in seconds)
PHYSICS_TIMESTEP=0.01

# ===========================
# RL Training Configuration
# ===========================
# Default RL algorithm: ppo, ddpg, sac
DEFAULT_RL_ALGORITHM=ppo

# Number of training episodes
DEFAULT_EPISODES=1000

# Checkpoint save frequency
CHECKPOINT_FREQ=100

# ===========================
# Experiment Tracking
# ===========================
# Weights & Biases
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=flyingcar-rl
WANDB_ENTITY=your_wandb_username

# Enable/disable experiment tracking
ENABLE_WANDB=false

# ===========================
# Cloud Integration (Optional)
# ===========================
# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=flyingcar-rl-data

# GCP Configuration
GCP_PROJECT_ID=your_gcp_project_id
GCP_BUCKET=flyingcar-rl-data

# ===========================
# Logging
# ===========================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory
LOG_DIR=data/logs

# ===========================
# Performance Settings
# ===========================
# GPU device ID (for multi-GPU systems)
CUDA_DEVICE=0

# Number of parallel workers
NUM_WORKERS=4

# Batch size for training
BATCH_SIZE=256
